{
  "name": "pi-infobar",
  "version": "0.2.0",
  "description": "High-contrast, readable info bar for the Pi coding agent.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "status",
    "footer",
    "codex",
    "quota",
    "limits",
    "usage",
    "git-status",
    "context"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "pi-infobar.png",
    "tsconfig.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "echo 'nothing to build'",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check",
    "deploy": "npm install && npm run check && npm run build && npm publish --access public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://github.com/inteist/pi-infobar/raw/main/pi-infobar.png"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.1",
    "@earendil-works/pi-tui": "^0.78.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
